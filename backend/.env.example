# Copier vers .env (ne JAMAIS pousser .env sur GitHub)
DATABASE_URL=sqlite:///./smartstay.db
# PostgreSQL : postgresql+psycopg2://user:password@localhost:5432/smartstay
MQTT_ENABLED=true
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_PREFIX=smartstay-manar
JWT_SECRET=change-me
# Règle fenêtre : décision d'équipe pas encore prise -> désactivée par défaut
WINDOW_RULE_ENABLED=false
# Dashboard déployé : ajouter son URL (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Tuya (serrure) : désactivé par défaut. Mettre les vraies valeurs UNIQUEMENT dans .env, jamais ici.
TUYA_ENABLED=false
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_BASE_URL=https://openapi.tuyaeu.com
